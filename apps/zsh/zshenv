### Secrets

# Load secrets from a separate file (untracked)
if [ -f ~/.zshenv.secrets ]; then
  source ~/.zshenv.secrets
fi

# Enable full color support in terminal
export COLORTERM=truecolor

# Default editor: VS Code, Vim
export EDITOR=vim
if command -v code >/dev/null 2>&1; then
    export EDITOR=code
else
    export EDITOR=vim
fi

# Populate PATH
export PATH="/opt/homebrew/bin:${HOME}/.local/bin:${PATH}"
[ -d "${HOME}/.cargo/bin" ] && export PATH="${HOME}/.cargo/bin:${PATH}"

# Set up proxy if the proxy port is listening
if nc -z 127.0.0.1 7897 2>/dev/null; then
    export http_proxy="http://127.0.0.1:7897"
    export https_proxy="http://127.0.0.1:7897"
    export no_proxy="localhost,127.0.0.1,::1"
    export HTTP_PROXY="http://127.0.0.1:7897"
    export HTTPS_PROXY="http://127.0.0.1:7897"
    export NO_PROXY="localhost,127.0.0.1,::1"
fi

# Keep more history
export HISTSIZE=100_000
export SAVEHIST=100_000
