# Caddy reverse proxy — configure services below.

# Tailscale DERP relay (non-standard port, SNI-routed)
derp.{$DOMAIN:localhost} {
    reverse_proxy https://derper:8080 {
        transport http {
            tls_insecure_skip_verify
        }
    }
    header Cache-Control "no-store"
}

{$DOMAIN:localhost} {
    respond "conduit" 200
    header Cache-Control "no-store"
}
