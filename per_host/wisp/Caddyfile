# Caddy reverse proxy — configure services below.

# Clash subscription — static file generated by subconv.py.
# Protected by a random path prefix (same approach your subscription
# provider uses).  The secret lives in subconv.env.
subconv.{$DOMAIN:localhost} {
    root * /srv/subconv
    file_server
    header Cache-Control "no-store"
}

mirror.{$DOMAIN:localhost} {
    root * /srv/mirror
    file_server browse
    header Cache-Control "no-store"
}

ghmirror.{$DOMAIN:localhost} {
    # Only proxy git smart-HTTP protocol paths.  Everything else (web UI,
    # login, API) returns 403 — this prevents the phishing false-positive
    # that the old githubmirror reverse-proxy triggered.
    @git path_regexp git ^/(.+)/(info/refs|git-upload-pack|git-receive-pack)$
    reverse_proxy @git https://github.com {
        header_up Host github.com
    }
    respond "forbidden" 403
}


