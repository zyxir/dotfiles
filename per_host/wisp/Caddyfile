# Caddy reverse proxy — configure services below.

# Clash subscription — static file generated by subconv.py.
# Protected by a random path prefix (same approach your subscription
# provider uses).  The secret lives in subconv.env.
subconv.{$DOMAIN:localhost} {
    root * /srv/subconv
    file_server
    header Cache-Control "no-store"
}

mirror.{$DOMAIN:localhost} {
    root * /srv/mirror
    file_server browse
    header Cache-Control "no-store"
}

githubmirror.{$DOMAIN:localhost} {
    reverse_proxy https://github.com {
        header_up Host github.com
    }
}

