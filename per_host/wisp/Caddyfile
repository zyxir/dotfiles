# Caddy reverse proxy — configure services below.

# Clash subscription — static file generated by subconv.py.
# Protected by a random path prefix (same approach your subscription
# provider uses).  The secret lives in subconv.env.
subconv.{$DOMAIN:localhost} {
    root * /srv/subconv
    file_server
    header Cache-Control "no-store"
}

mirror.{$DOMAIN:localhost} {
    root * /srv/mirror
    file_server browse
    header Cache-Control "no-store"
}

ghmirror.{$DOMAIN:localhost} {
    # Git-only reverse proxy.  Only paths under the repos listed below are
    # proxied to GitHub — everything else returns 403.  No web UI, no login
    # page (avoids phishing false-positives from Netcraft).
    #
    # To add a repo, append || {path}.startsWith('/owner/repo'):
    #   {path}.startsWith('/zyxir/dotfiles') || {path}.startsWith('/owner2/repo2')
    @repos expression `{path}.startsWith('/zyxir/dotfiles')`
    reverse_proxy @repos https://github.com {
        header_up Host github.com
    }
    respond "forbidden" 403
}


