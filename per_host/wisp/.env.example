# Domain for Caddy routes (e.g., example.com)
DOMAIN=

# Cloudflare API — used by installer to manage DNS records.
# Create a scoped API token at https://dash.cloudflare.com/profile/api-tokens
# with Zone.Zone (read) and Zone.DNS (edit) permissions.
CLOUDFLARE_API_TOKEN=

# Database
DB_USER=
DB_PASSWORD=