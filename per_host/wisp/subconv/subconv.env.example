# Clash subscription URLs — separate from .env because they change more
# often (provider switches, token rotation).
#
# Add as many as needed — proxies from all subscriptions are merged.
# Duplicate proxy names are renamed: "Node A" → "Node A (sub2)"
SUBSCRIPTION_URL_1=
# SUBSCRIPTION_URL_2=
# SUBSCRIPTION_URL_3=

# Random path secret — protects the config from unauthorized access.
# Generate: head -c 16 /dev/urandom | xxd -p
# Subscribe: https://subconv.<domain>/<SECRET>/ZyProxy
SECRET=
